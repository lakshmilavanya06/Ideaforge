# Copy this file to .env and fill in your own values before running in production.
# For local development, the defaults in the code work fine without a .env file at all.

PORT=3000

# Set this to "production" when deploying somewhere public (e.g. OCI).
# When set, the server refuses to start unless you've also set a real
# JWT_SECRET below - this stops you from accidentally deploying with the
# publicly-known default secret still active.
NODE_ENV=development

# Used to sign login tokens (JWTs). Change this to a long random string
# before deploying anywhere public - anyone who knows this secret could
# forge login tokens.
JWT_SECRET=replace-this-with-a-long-random-string
